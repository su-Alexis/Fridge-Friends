{
  "name": "perishable-recipe-matcher",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "prebuild": "npm run recipes:check",
    "build": "vite build",
    "postbuild": "node scripts/build-sw.mjs",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build:wrapper": "npm run build",
    "recipes:check": "node scripts/recipes.mjs check",
    "recipes:add": "node scripts/recipes.mjs add"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.70.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0"
  },
  "type": "module",
  "displayName": "Perishable Recipe Matcher"
}
